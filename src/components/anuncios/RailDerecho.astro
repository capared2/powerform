  <div class="anuncio-slot" style="width:160px;height:300px">
    <script is:inline>
      atOptions = {
        'key' : '1c8d41be97dd1139ceb8c390ffb0cd41',
        'format' : 'iframe',
        'height' : 300,
        'width' : 160,
        'params' : {}
      };
    </script>
