---
import '../styles/global.css';
import Leaderboard from '../components/anuncios/Leaderboard.astro';
import Nativo from '../components/anuncios/Nativo.astro';
import MovilSticky from '../components/anuncios/MovilSticky.astro';
import RailIzquierdo from '../components/anuncios/RailIzquierdo.astro';
import RailDerecho from '../components/anuncios/RailDerecho.astro';
import AnuncioGlobal from '../components/anuncios/Global.astro';
import Icon from '../components/Icon.astro';
import BarraPestanas from '../components/app/BarraPestanas.astro';
import Hoja from '../components/app/Hoja.astro';
import ChipsSorteos from '../components/app/ChipsSorteos.astro';
import { JUEGOS_NAV, seccionDe, pantallaDe } from '../data/navegacion.js';

interface Props {
  title: string;
  description: string;
  canonical: string;
  robots?: string;
  fullNav?: boolean;
  activeFooterLink?: 'contacto' | 'terminos' | 'privacidad';
}

const {
  title,
  description,
  canonical,
  robots = 'index, follow',
  fullNav = false,
  activeFooterLink,
} = Astro.props;

// Interfaz tipo app en móvil: pestaña activa, título de la app bar y destino
// del botón "Volver" se calculan a partir de la URL.
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const seccion = seccionDe(pathname);
const { titulo: tituloPantalla, atras } = pantallaDe(pathname);
const mostrarChips = pathname === '/' || JUEGOS_NAV.some((j) => j.href === pathname);
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={robots} />
  <meta name="author" content="ResultPowerball - Resultados en Español" />
  <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <meta name="bingbot" content="index, follow" />
  <meta http-equiv="content-language" content="es" />
  <meta name="language" content="Spanish" />
  <meta name="HandheldFriendly" content="True" />
  <meta name="MobileOptimized" content="320" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%23DC2626'/><circle cx='16' cy='16' r='9' fill='white'/><text x='16' y='21' text-anchor='middle' font-size='13' font-weight='bold' fill='%23DC2626'>PB</text></svg>" />

  <!-- PWA: instalable como app (manifest + íconos + barra de estado) -->
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#ffffff" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="ResultPB" />
  <meta name="application-name" content="ResultPB" />
  <meta name="format-detection" content="telephone=no" />

  <!-- Page-specific head content (JSON-LD, OG, Twitter, keywords, etc.) -->
  <slot name="head" />

  <!-- Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://www.highrevenueformat.com" crossorigin />
  <link rel="preconnect" href="https://pl29624141.profitableratecpmnetwork.com" crossorigin />
  <link rel="dns-prefetch" href="https://pl29624143.profitableratecpmnetwork.com" />

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <!-- Google Analytics -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-ZQ3EWYTH5G"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-ZQ3EWYTH5G');
  </script>
</head>
<body class="bg-white min-h-screen">

  <!-- HEADER (fijo). En móvil funciona como app bar: logo en la home; en las
       demás páginas, botón "Volver" + título de la pantalla. -->
  <header id="appHeader" class="app-header fixed top-0 inset-x-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur-md">
    <div class="h-1 bg-gradient-to-r from-red-600 via-white to-blue-900"></div>
    <div class="app-header-barra max-w-6xl mx-auto px-2 lg:px-4 h-14 lg:h-16 flex items-center justify-between gap-1">
      {atras && (
        <a href={atras} id="btnAtras" class="app-icon-btn inline-flex lg:hidden text-blue-950" aria-label="Volver">
          <Icon name="chevron-left" class="w-7 h-7" />
        </a>
      )}

      <a href="/" class={`items-center gap-2.5 pl-2 lg:pl-0 ${tituloPantalla ? 'hidden lg:flex' : 'flex'}`}>
        <div class="bg-red-600 rounded-lg p-1.5">
          <Icon name="star" class="w-5 h-5 text-white" />
        </div>
        <span class="font-display text-xl font-bold text-blue-950 tracking-tight">Result<span class="text-red-600">PB</span></span>
      </a>

      {tituloPantalla && (
        <p class="lg:hidden flex-1 min-w-0 truncate font-display text-lg font-semibold text-blue-950 tracking-tight">{tituloPantalla}</p>
      )}

      <button type="button" id="btnCompartir" class="app-icon-btn inline-flex lg:hidden text-blue-950 ml-auto" aria-label="Compartir esta página">
        <Icon name="share" class="w-[22px] h-[22px]" />
      </button>

      <nav class="hidden lg:flex items-center gap-6">
        <a href="/#resultados" class="text-slate-600 hover:text-blue-950 text-sm font-medium nav-link transition-colors">Resultados</a>
        <div class="relative" id="sorteosDropdown">
          <button id="sorteosBtn" class="flex items-center gap-1 text-slate-600 hover:text-blue-950 text-sm font-medium transition-colors" aria-haspopup="true" aria-expanded="false">
            Sorteos
            <i data-lucide="chevron-down" class="w-4 h-4"></i>
          </button>
          <div id="sorteosMenu" class="hidden absolute left-1/2 -translate-x-1/2 top-full pt-3 w-56">
            <div class="bg-white border border-slate-200 rounded-xl shadow-xl py-2">
              {JUEGOS_NAV.map((j) => (
                <a href={j.href} class="block px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-red-50 hover:text-red-600 transition-colors">{j.nombre}</a>
              ))}
              <div class="border-t border-slate-200 my-1"></div>
              <a href="/resultados/" class="block px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-red-50 hover:text-red-600 transition-colors">Resultados anteriores</a>
            </div>
          </div>
        </div>
        <a href="/#como-jugar" class="text-slate-600 hover:text-blue-950 text-sm font-medium nav-link transition-colors">Cómo Jugar</a>
        <a href="/#premios" class="text-slate-600 hover:text-blue-950 text-sm font-medium nav-link transition-colors">Premios</a>
        <a href="/estados/" class="text-slate-600 hover:text-blue-950 text-sm font-medium nav-link transition-colors">Estados</a>
        <a href="/#faq" class="text-slate-600 hover:text-blue-950 text-sm font-medium nav-link transition-colors">FAQ</a>
      </nav>
    </div>
  </header>

  <!-- ANUNCIOS: rails laterales (solo ≥1536px, fuera del flujo del contenido) -->
  <RailIzquierdo />
  <RailDerecho />

  <!-- ANUNCIO: leaderboard superior (solo desktop, encima del hero) -->
  <div class="hidden md:block bg-white pt-4 pb-3">
    <Leaderboard />
  </div>

  <!-- MÓVIL: chips para saltar entre juegos (home + páginas de cada juego) -->
  {mostrarChips && <ChipsSorteos actual={pathname} />}

  <!-- PAGE CONTENT -->
  <slot />

  <!-- ANUNCIO: native banner de cierre, antes del footer -->
  <div class="px-4 py-10 bg-slate-50 border-t border-slate-200">
    <Nativo />
  </div>

  <!-- SCROLL TO TOP (solo desktop: en móvil se sube tocando la pestaña activa) -->
  <button id="scrollTop" class="hidden lg:block fixed bottom-6 right-6 bg-red-600 text-white p-3 rounded-full shadow-lg opacity-0 pointer-events-none transition-opacity hover:bg-red-700 z-40">
    <i data-lucide="arrow-up" class="w-6 h-6"></i>
  </button>

  <!-- FOOTER -->
  <footer id="footer" class="px-4 pt-10 pb-6 bg-blue-950 border-t-4 border-red-600">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10">
        <div class="col-span-2 lg:col-span-1">
          <a href="/" class="inline-flex items-center gap-2">
            <div class="bg-red-600 rounded-lg p-1">
              <i data-lucide="star" class="w-4 h-4 text-white"></i>
            </div>
            <span class="font-display text-lg font-bold text-white">Result<span class="text-red-400">PB</span></span>
          </a>
          <p class="text-blue-300 text-sm mt-2 leading-relaxed">Resultados de las loterías de USA en español, actualizados después de cada sorteo.</p>
        </div>

        <nav aria-label="Sorteos">
          <p class="text-white font-semibold text-xs uppercase tracking-widest mb-3">Sorteos</p>
          <ul class="space-y-2.5 text-sm">
            {JUEGOS_NAV.map((j) => (
              <li><a href={j.href} class="text-blue-300 hover:text-white transition-colors">{j.nombre}</a></li>
            ))}
          </ul>
        </nav>

        <nav aria-label="Powerball">
          <p class="text-white font-semibold text-xs uppercase tracking-widest mb-3">Powerball</p>
          <ul class="space-y-2.5 text-sm">
            <li><a href="/#resultados" class="text-blue-300 hover:text-white transition-colors">Resultados de hoy</a></li>
            <li><a href="/resultados/" class="text-blue-300 hover:text-white transition-colors">Resultados anteriores</a></li>
            <li><a href="/#como-jugar" class="text-blue-300 hover:text-white transition-colors">Cómo jugar</a></li>
            <li><a href="/#premios" class="text-blue-300 hover:text-white transition-colors">Premios</a></li>
            <li><a href="/estados/" class="text-blue-300 hover:text-white transition-colors">Powerball por estado</a></li>
          </ul>
        </nav>

        <nav aria-label="Sitio">
          <p class="text-white font-semibold text-xs uppercase tracking-widest mb-3">Sitio</p>
          <ul class="space-y-2.5 text-sm">
            <li><a href="/#faq" class="text-blue-300 hover:text-white transition-colors">Preguntas frecuentes</a></li>
            <li><a href="/contacto/" class={`text-blue-300 hover:text-white transition-colors ${activeFooterLink === 'contacto' ? 'text-white font-semibold' : ''}`}>Contacto</a></li>
            <li><a href="/terminos/" class={`text-blue-300 hover:text-white transition-colors ${activeFooterLink === 'terminos' ? 'text-white font-semibold' : ''}`}>Términos</a></li>
            <li><a href="/privacidad/" class={`text-blue-300 hover:text-white transition-colors ${activeFooterLink === 'privacidad' ? 'text-white font-semibold' : ''}`}>Privacidad</a></li>
          </ul>
        </nav>
      </div>

      <div class="mt-10 pt-6 border-t border-blue-900">
        <p class="text-blue-400 text-xs text-center max-w-2xl mx-auto leading-relaxed px-2">
          ResultPowerball no está afiliado con la Multi-State Lottery Association (MUSL). Este sitio es solo para información. Los resultados oficiales están en
          <a href="https://www.powerball.com" class="text-red-400 hover:underline" target="_blank" rel="noopener noreferrer">powerball.com</a>.
          No promovemos ni alentamos las apuestas. Juega responsablemente.
        </p>
        <p class="text-blue-500 text-xs text-center mt-4">
          © <span id="current-year">2026</span> ResultPowerball. Todos los derechos reservados.
        </p>
      </div>
    </div>
  </footer>

  <!-- ANUNCIO: barra fija inferior (solo móvil, encima de la barra de pestañas) -->
  <MovilSticky />

  <!-- ============ INTERFAZ TIPO APP (móvil y tablet, < lg) ============ -->
  <BarraPestanas seccion={seccion} actual={pathname} />

  <Hoja id="hojaSorteos" titulo="Sorteos">
    <ul class="lista-app">
      {JUEGOS_NAV.map((j) => (
        <li>
          <a href={j.href} class="fila-app" aria-current={pathname === j.href ? 'page' : undefined}>
            <span class={`fila-icono bola text-[11px] font-bold ${j.bolaClases}`}>{j.abrev}</span>
            <span class="flex-1 min-w-0">
              <span class="block font-semibold text-blue-950">{j.nombre}</span>
              <span class="block text-xs text-slate-500 truncate">{j.dias} · {j.hora}</span>
            </span>
            <Icon name="chevron-right" class="w-5 h-5 text-slate-400 shrink-0" />
          </a>
        </li>
      ))}
    </ul>
    <ul class="lista-app mt-4">
      <li>
        <a href="/resultados/" class="fila-app">
          <span class="fila-icono bg-blue-900 text-white"><Icon name="history" class="w-[18px] h-[18px]" /></span>
          <span class="flex-1 font-semibold text-blue-950">Resultados anteriores</span>
          <Icon name="chevron-right" class="w-5 h-5 text-slate-400 shrink-0" />
        </a>
      </li>
    </ul>
  </Hoja>

  <Hoja id="hojaMenu" titulo="Más">
    <div id="bloqueInstalar" class="mb-1" hidden>
      <button type="button" id="btnInstalar" class="w-full flex items-center gap-3 bg-red-600 active:bg-red-700 text-white rounded-2xl px-4 py-3.5 text-left presionable">
        <span class="fila-icono bg-white/20"><Icon name="download" class="w-[18px] h-[18px]" /></span>
        <span class="flex-1 min-w-0">
          <span class="block font-semibold">Instalar la app</span>
          <span class="block text-xs text-red-100">Resultados a un toque desde tu pantalla de inicio</span>
        </span>
      </button>
      <p id="ayudaIos" class="text-sm text-slate-600 bg-white rounded-2xl px-4 py-3 mt-2 leading-relaxed" hidden>
        En iPhone: toca <Icon name="share" class="inline w-4 h-4 -mt-1 text-blue-600" /> <strong>Compartir</strong> en Safari y luego
        <Icon name="square-plus" class="inline w-4 h-4 -mt-1 text-blue-600" /> <strong>Agregar a inicio</strong>.
      </p>
    </div>

    <p class="lista-app-titulo">Powerball</p>
    <ul class="lista-app">
      <li><a href="/#resultados" class="fila-app"><span class="fila-icono bg-red-600 text-white"><Icon name="calendar-days" class="w-[18px] h-[18px]" /></span><span class="flex-1 font-medium text-blue-950">Resultados de hoy</span><Icon name="chevron-right" class="w-5 h-5 text-slate-400 shrink-0" /></a></li>
      <li><a href="/#como-jugar" class="fila-app"><span class="fila-icono bg-blue-900 text-white"><Icon name="book-open" class="w-[18px] h-[18px]" /></span><span class="flex-1 font-medium text-blue-950">Cómo jugar</span><Icon name="chevron-right" class="w-5 h-5 text-slate-400 shrink-0" /></a></li>
      <li><a href="/#premios" class="fila-app"><span class="fila-icono bg-amber-500 text-white"><Icon name="trophy" class="w-[18px] h-[18px]" /></span><span class="flex-1 font-medium text-blue-950">Premios</span><Icon name="chevron-right" class="w-5 h-5 text-slate-400 shrink-0" /></a></li>
      <li><a href="/#faq" class="fila-app"><span class="fila-icono bg-emerald-600 text-white"><Icon name="circle-help" class="w-[18px] h-[18px]" /></span><span class="flex-1 font-medium text-blue-950">Preguntas frecuentes</span><Icon name="chevron-right" class="w-5 h-5 text-slate-400 shrink-0" /></a></li>
    </ul>

    <p class="lista-app-titulo">Sitio</p>
    <ul class="lista-app">
      <li><a href="/contacto/" class="fila-app" aria-current={pathname === '/contacto/' ? 'page' : undefined}><span class="fila-icono bg-slate-500 text-white"><Icon name="mail" class="w-[18px] h-[18px]" /></span><span class="flex-1 font-medium text-blue-950">Contacto</span><Icon name="chevron-right" class="w-5 h-5 text-slate-400 shrink-0" /></a></li>
      <li><a href="/terminos/" class="fila-app" aria-current={pathname === '/terminos/' ? 'page' : undefined}><span class="fila-icono bg-slate-500 text-white"><Icon name="file-text" class="w-[18px] h-[18px]" /></span><span class="flex-1 font-medium text-blue-950">Términos</span><Icon name="chevron-right" class="w-5 h-5 text-slate-400 shrink-0" /></a></li>
      <li><a href="/privacidad/" class="fila-app" aria-current={pathname === '/privacidad/' ? 'page' : undefined}><span class="fila-icono bg-slate-500 text-white"><Icon name="shield" class="w-[18px] h-[18px]" /></span><span class="flex-1 font-medium text-blue-950">Privacidad</span><Icon name="chevron-right" class="w-5 h-5 text-slate-400 shrink-0" /></a></li>
    </ul>

    <p class="text-xs text-slate-500 text-center mt-5 px-4 leading-relaxed">
      No afiliado con la Multi-State Lottery Association. Juega responsablemente.
    </p>
  </Hoja>

  <!-- Aviso breve tipo snackbar (p. ej. "Enlace copiado") -->
  <div id="toast" class="toast" role="status" aria-live="polite"></div>

  <!-- Lucide Icons CDN -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/lucide@latest/dist/umd/lucide.js"></script>
  <!-- Main JS -->
  <script is:inline src="/main.js"></script>
  <!-- ANUNCIOS: script global de la red (una sola vez por página) -->
  <AnuncioGlobal />
</body>
</html>
