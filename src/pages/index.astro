    <!-- ======== FAQ ======== -->
    <section id="faq" class="py-16 px-4">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10">
          <h2 class="font-display text-3xl font-bold text-blue-950 mb-2">Preguntas <span class="text-red-600">Frecuentes</span></h2>
          <p class="text-slate-500">Todo lo que necesitas saber sobre el Powerball</p>
        </div>
        <div class="space-y-3" id="faq-list">
          {faqs.map((faq, i) => (
            <div class="bg-white border border-slate-200 rounded-xl overflow-hidden">
              <button
                class="w-full flex items-center justify-between px-5 py-4 text-left hover:bg-slate-50 transition-colors"
                onclick={`toggleFaq(${i})`}
              >
                <div class="flex items-center gap-3 pr-4">
                  <i data-lucide="help-circle" class="w-5 h-5 text-red-600 flex-shrink-0"></i>
                  <span class="text-blue-950 font-medium text-sm">{faq.pregunta}</span>
                </div>
                <i data-lucide="chevron-down" class={`w-5 h-5 text-slate-500 faq-chevron flex-shrink-0`} id={`chevron-${i}`}></i>
              </button>
              <div class="faq-body px-5" id={`faq-body-${i}`}>
                <p class="text-slate-600 text-sm leading-relaxed" set:html={faq.respuesta}></p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <!-- FAQ toggle script — must be inline so toggleFaq() is globally available for onclick handlers -->
  <script is:inline>
    function toggleFaq(index) {
      const body = document.getElementById('faq-body-' + index);
      const chevron = document.getElementById('chevron-' + index);
      if (!body || !chevron) return;
      const isOpen = body.classList.contains('open');
      document.querySelectorAll('[id^="faq-body-"]').forEach(function(b) { b.classList.remove('open'); });
      document.querySelectorAll('[id^="chevron-"]').forEach(function(c) { c.classList.remove('open'); });
      if (!isOpen) {
        body.classList.add('open');
        chevron.classList.add('open');
      }
    }
  </script>
</Layout>
