            </div>
          </div>
          <div class="bg-white border border-slate-200 rounded-xl p-6 hover:border-red-600 transition-colors">
            <div class="flex items-center gap-4">
              <div class="bg-blue-900 rounded-full w-12 h-12 flex items-center justify-center flex-shrink-0">
