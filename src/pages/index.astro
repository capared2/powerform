        </div>
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-white border border-slate-200 rounded-xl p-6">
            <h3 class="font-display text-xl font-bold text-blue-950 mb-4 flex items-center gap-2">
