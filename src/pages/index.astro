---
import Layout from '../layouts/Layout.astro';
import resultadosData from '../data/resultados.json';
import sorteosData from '../data/sorteos.json';
import { JUEGOS, OTROS_JUEGOS, esVigente, formatearDineroCorto } from '../data/juegos.js';
import { fechaLarga, fechaConDia, fechaTarjeta } from '../utils/fechas.js';
import Rectangulo from '../components/anuncios/Rectangulo.astro';
import Banner468 from '../components/anuncios/Banner468.astro';

// Último sorteo disponible en build-time (el JSON se actualiza 3x/semana vía GitHub Actions).
// Si aún no hay datos, la página cae al comportamiento anterior (skeleton + fetch en cliente).
const ultimo = resultadosData.sorteos?.[0] ?? null;

// Datos multi-juego del backend (capa2): Mega Millions, Lotto America, Cash4Life
// y Double Play del Powerball. Todos los juegos se muestran siempre: con
// placeholder si aún no hay datos, y con nota si el último dato está atrasado.
const juegosBackend = sorteosData.juegos ?? {};
const otrosSorteos = OTROS_JUEGOS.map((id) => {
  const data = juegosBackend[id] ?? null;
  return { id, meta: JUEGOS[id], data, vigente: data ? esVigente(data.sorteo.fecha) : false };
});

// Double Play: solo si el backend lo trae para el mismo sorteo que muestra la tarjeta.
const dobleJugada =
  ultimo && juegosBackend.powerball?.sorteo?.fecha === ultimo.fecha
    ? juegosBackend.powerball.sorteo.doble_jugada ?? null
    : null;

const title = ultimo
  ? `Resultados Powerball hoy: números del ${fechaLarga(ultimo.fecha)} y más loterías`
  : 'Resultados Powerball, Mega Millions y Loterías USA HOY en Español';
const description = ultimo
  ? `Números ganadores del Powerball del ${fechaConDia(ultimo.fecha)}: ${ultimo.blancos.join(', ')} y Powerball ${ultimo.powerball}.${ultimo.powerplay ? ` Power Play ${ultimo.powerplay}x.` : ''} También Mega Millions, Lotto America y Cash4Life en español.`
  : 'Resultados oficiales de las loterías de USA en español: Powerball, Mega Millions, Lotto America y Cash4Life. Números ganadores actualizados después de cada sorteo.';
const fechaModificacion = ultimo ? ultimo.fecha : '2026-02-03';

const faqs = [
  {
    pregunta: "¿Cuándo se juega el Powerball?",
    respuesta: "El Powerball se juega tres veces por semana: los <strong class=\"text-slate-800\">lunes, miércoles y sábados</strong>. Los sorteos ocurren a las 10:59 PM Eastern Time (ET), lo cual equivale a las 9:59 PM Central Time, 8:59 PM Mountain Time y 7:59 PM Pacific Time."
  },
  {
    pregunta: "¿Cómo jugar al Powerball?",
    respuesta: "Para jugar debes <strong class=\"text-slate-800\">elegir 5 números del 1 al 69</strong> (los blancos) y <strong class=\"text-slate-800\">1 número Powerball del 1 al 26</strong> (el rojo). Compra un boleto en cualquier estado participante por $2 USD. Si quieres multiplicar tus premios menores, agrega el Power Play por $1 adicional."
  },
  {
    pregunta: "¿Cuánto cuesta un boleto de Powerball?",
    respuesta: "Un boleto de Powerball cuesta <strong class=\"text-slate-800\">$2 USD</strong>. Si decides agregar la opción Power Play cuesta <strong class=\"text-slate-800\">$1 USD adicional</strong> (total $3). El Power Play multiplica los premios menores según el multiplicador sorteado (2x, 3x, 4x, 5x o 10x)."
  },
  {
    pregunta: "¿Cuáles son las probabilidades de ganar el Powerball?",
    respuesta: "La probabilidad de ganar el gran premio (jackpot) es <strong class=\"text-slate-800\">1 en 292,201,338</strong>. Sin embargo, hay 9 niveles de premios y la probabilidad de ganar <strong class=\"text-slate-800\">cualquier premio</strong> es mucho mejor: aproximadamente <strong class=\"text-slate-800\">1 en 24.9</strong>."
  },
  {
    pregunta: "¿Qué es el Power Play?",
    respuesta: "El Power Play es una opción opcional por <strong class=\"text-slate-800\">$1 USD adicional</strong>. Si ganas un premio menor (no el jackpot) y tienes Power Play, tu premio se multiplica por el número sorteado ese día. El multiplicador puede ser <strong class=\"text-slate-800\">2x, 3x, 4x, 5x o incluso 10x</strong>. El premio de $1 millón siempre se duplica a $2 millones con Power Play."
  },
  {
    pregunta: "¿Puedo jugar Powerball desde fuera de Estados Unidos?",
    respuesta: "Los boletos oficiales solo se compran físicamente en Estados Unidos, Puerto Rico o Islas Vírgenes. Sin embargo, si tienes <strong class=\"text-slate-800\">familiares o amigos en EE.UU.</strong> ellos pueden comprar el boleto por ti. También existen servicios de mensajería de lotería autorizados que compran boletos en tu nombre."
  },
  {
    pregunta: "¿Premio estimado vs Premio en efectivo, cuál es la diferencia?",
    respuesta: "El <strong class=\"text-slate-800\">Premio Estimado (Annuity)</strong> es el jackpot total que se paga en 30 cuotas anuales que aumentan 5% cada año. El <strong class=\"text-slate-800\">Premio en Efectivo (Lump Sum)</strong> es lo que recibas si cobras todo de un golpe, generalmente el 50–60% del total. En ambos casos se aplican impuestos federales y estatales."
  },
  {
    pregunta: "¿En qué estados se puede jugar Powerball?",
    respuesta: "Powerball se juega en <strong class=\"text-slate-800\">45 estados</strong>: todos excepto Alabama, Alaska, Hawaii, Nevada y Utah. También se juega en <strong class=\"text-slate-800\">Washington DC, Puerto Rico e Islas Vírgenes de EE.UU.</strong> Los resultados son válidos en todos estos territorios."
  }
];
---

<Layout
  title={title}
  description={description}
  canonical="https://resultpowerball.com/"
  robots="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  fullNav={true}
>
  <!-- Page-specific head: keywords, OG, Twitter, JSON-LD, geo -->
  <Fragment slot="head">
    <meta name="keywords" content="resultados powerball hoy, números ganadores powerball, powerball en español, loteria powerball resultados, powerball estados unidos, powerball california, powerball texas, powerball florida, powerball nueva york, powerball puerto rico, como jugar powerball, jackpot powerball hoy, powerball esta semana, verificar powerball, powerball premio estimado, powerball ganadores hoy, powerball último sorteo, números calientes powerball, números fríos powerball, estadísticas powerball, power play que es, cuanto cuesta powerball, donde comprar powerball, como cobrar powerball, probabilidades powerball, premio en efectivo powerball, powerball millones, mega millions vs powerball, powerball online, consultar powerball, sorteo powerball en vivo, powerball latinos, powerball hispanos, powerball mexicanos en usa, powerball dominicanos, powerball salvadoreños, powerball guatemaltecos, powerball hondureños en usa, powerball colombia, powerball venezuela, powerball argentina, powerball chile, powerball peru, powerball ecuador, powerball latinoamerica, powerball español usa, loteria americana en español, cuando juega powerball hoy, a que hora es el sorteo powerball, numeros ganadores powerball ayer, powerball cuanto esta hoy, resultado loteria powerball, powerball en vivo, resultados mega millions hoy, mega millions en español, numeros ganadores mega millions, resultados lotto america, lotto america en español, resultados cash4life, cash4life en español, loterias de estados unidos en español, resultados loterias usa" />
    <meta name="theme-color" content="#DC2626" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="ResultPB" />
    <meta name="geo.region" content="US" />
    <meta name="geo.placename" content="United States, California, Texas, Florida, New York, Puerto Rico, Arizona, Georgia, Illinois, North Carolina, Pennsylvania" />
    <meta name="geo.position" content="37.0902;-95.7129" />
    <meta name="ICBM" content="37.0902, -95.7129" />
    <meta name="DC.title" content="Resultados Powerball en Español - Números Ganadores Actualizados" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ResultPowerball - Resultados en Español" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://resultpowerball.com/" />
    <meta property="og:image" content="https://resultpowerball.com/powerball-estados.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Resultados del Powerball en español - números ganadores" />
    <meta property="og:locale" content="es_US" />
    <meta property="og:locale:alternate" content="es_MX" />
    <meta property="og:locale:alternate" content="es_PR" />
    <meta property="article:published_time" content="2026-02-03T00:00:00-05:00" />
    <meta property="article:modified_time" content={`${fechaModificacion}T00:00:00-05:00`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ResultPowerball" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://resultpowerball.com/powerball-estados.jpg" />
    <meta name="twitter:image:alt" content="Resultados del Powerball en español - números ganadores" />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'ResultPowerball',
      alternateName: ['Resultados Powerball', 'Powerball en Español', 'Números Ganadores Powerball', 'Resultados Loterías USA'],
      url: 'https://resultpowerball.com/',
      description: 'Resultados de las loterías de USA en español: Powerball, Mega Millions, Lotto America y Cash4Life. Números ganadores actualizados después de cada sorteo.',
      inLanguage: 'es',
      publisher: {
        '@type': 'Organization',
        name: 'ResultPowerball',
        url: 'https://resultpowerball.com/',
        logo: { '@type': 'ImageObject', url: 'https://resultpowerball.com/logo.svg' },
      },
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description: description,
      image: 'https://resultpowerball.com/powerball-estados.jpg',
      author: { '@type': 'Organization', name: 'ResultPowerball' },
      publisher: {
        '@type': 'Organization',
        name: 'ResultPowerball',
        logo: { '@type': 'ImageObject', url: 'https://resultpowerball.com/logo.svg' },
      },
      mainEntityOfPage: 'https://resultpowerball.com/',
      datePublished: '2026-02-03',
      dateModified: fechaModificacion,
    })} />

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "¿Cuándo se juega el Powerball?", "acceptedAnswer": { "@type": "Answer", "text": "El Powerball se juega tres veces por semana: los lunes, miércoles y sábados a las 10:59 PM Eastern Time. Los resultados se publican inmediatamente después del sorteo oficial." } },
        { "@type": "Question", "name": "¿Cómo jugar al Powerball desde Estados Unidos?", "acceptedAnswer": { "@type": "Answer", "text": "Elige 5 números del 1 al 69 y 1 número Powerball del 1 al 26. Compra un boleto por $2 USD en cualquier estado participante." } },
        { "@type": "Question", "name": "¿Cuánto cuesta un boleto de Powerball?", "acceptedAnswer": { "@type": "Answer", "text": "Un boleto de Powerball cuesta $2 USD. La opción Power Play cuesta $1 adicional y puede multiplicar tus premios menores por 2x, 3x, 4x, 5x o hasta 10x." } },
        { "@type": "Question", "name": "¿Cuáles son las probabilidades de ganar el Powerball?", "acceptedAnswer": { "@type": "Answer", "text": "La probabilidad de ganar el gran premio (jackpot) es 1 en 292,201,338. La probabilidad de ganar cualquier premio es 1 en 24.9." } },
        { "@type": "Question", "name": "¿Qué es el Power Play en Powerball?", "acceptedAnswer": { "@type": "Answer", "text": "Power Play es una opción adicional por $1 que multiplica tus premios menores por 2x, 3x, 4x, 5x o 10x. El premio de $1 millón puede convertirse en $2 millones con Power Play." } },
        { "@type": "Question", "name": "¿En qué estados se puede jugar Powerball?", "acceptedAnswer": { "@type": "Answer", "text": "Powerball se juega en 45 estados más DC, Puerto Rico e Islas Vírgenes." } }
      ]
    }
    </script>

  </Fragment>

  <main>

    <!-- ======== HERO + RESULTADOS ======== -->
    <section id="resultados" class="hero-bg pt-14 pb-16 px-4">
      <div class="max-w-4xl mx-auto text-center">

        <div class="inline-flex items-center gap-2 bg-white border border-slate-300 rounded-full px-4 py-1.5 mb-6 badge-pulse">
          <i data-lucide="clock" class="w-4 h-4 text-red-600"></i>
          <span class="text-sm text-slate-700" id="proximo-sorteo">Sorteos: lunes, miércoles y sábado · 10:59 PM ET</span>
        </div>

        <h1 class="font-display text-4xl md:text-5xl font-bold text-blue-950 mb-2 tracking-tight leading-tight">
          Resultados del <span class="text-red-600">Powerball</span> y Loterías USA
        </h1>
        <p class="text-slate-500 mb-10 text-base max-w-xl mx-auto">
          Powerball · Mega Millions · Lotto America · Cash4Life — números ganadores actualizados después de cada sorteo
        </p>

        <div class="max-w-2xl mx-auto">
          <!-- SKELETON (solo si aún no hay datos de build) -->
          {!ultimo && (
            <div id="skeleton-card" class="bg-white border border-slate-200 rounded-2xl p-8 card-glow">
              <div class="skel w-40 h-4 bg-slate-200 rounded-full mx-auto mb-7"></div>
              <div class="flex items-center justify-center gap-3 mb-8">
                <div class="skel w-14 h-14 bg-slate-200 rounded-full"></div>
                <div class="skel w-14 h-14 bg-slate-200 rounded-full" style="animation-delay:.15s"></div>
                <div class="skel w-14 h-14 bg-slate-200 rounded-full" style="animation-delay:.3s"></div>
                <div class="skel w-14 h-14 bg-slate-200 rounded-full" style="animation-delay:.45s"></div>
                <div class="skel w-14 h-14 bg-slate-200 rounded-full" style="animation-delay:.6s"></div>
                <div class="w-1 h-10 bg-slate-100 mx-1 rounded"></div>
                <div class="skel w-16 h-16 bg-slate-200 rounded-full" style="animation-delay:.75s"></div>
              </div>
              <div class="skel w-24 h-6 bg-slate-200 rounded-full mx-auto mb-6"></div>
              <div class="flex justify-center gap-4">
                <div class="skel w-36 h-20 bg-slate-200 rounded-xl"></div>
                <div class="skel w-36 h-20 bg-slate-200 rounded-xl"></div>
              </div>
            </div>
          )}

          <!-- RESULTADOS: renderizados en build-time y refrescados en cliente si hay datos más nuevos -->
          <div
            id="real-card"
            class={`${ultimo ? '' : 'hidden '}bg-white border border-slate-200 rounded-2xl p-8 card-glow`}
            data-static={ultimo ? '1' : undefined}
          >
            <div class="flex items-center justify-center gap-2 text-slate-500 mb-6">
              <i data-lucide="calendar" class="w-4 h-4"></i>
              <span id="fecha-sorteo" class="text-sm font-medium">{ultimo ? fechaTarjeta(ultimo.fecha) : '—'}</span>
            </div>
            <div class="flex items-center justify-center gap-2 flex-wrap mb-2" style="max-width: 100%;">
              <div id="blancos" class="flex gap-2 flex-wrap justify-center">
                {ultimo && ultimo.blancos.map((n) => <div class="ball-white">{n}</div>)}
              </div>
              <div class="w-px h-12 bg-slate-200 mx-1"></div>
              <div id="pb-ball" class="ball-red">{ultimo ? ultimo.powerball : 0}</div>
            </div>
            <p class="text-center text-red-600 text-xs font-semibold uppercase tracking-widest mb-5">Powerball</p>
            <div class="flex justify-center mb-7">
              <div class="bg-red-50 border border-red-200 text-red-600 text-sm font-semibold rounded-full px-5 py-1.5 flex items-center gap-2">
                <i data-lucide="zap" class="w-4 h-4"></i>
                Power Play · <span id="pp-value" class="text-blue-950 font-bold">{ultimo?.powerplay ? `${ultimo.powerplay}x` : '—'}</span>
              </div>
            </div>
            {dobleJugada && (
              <div class="border-t border-slate-200 pt-5 mb-7">
                <p class="text-center text-slate-500 text-xs font-semibold uppercase tracking-widest mb-3">Double Play</p>
                <div class="flex items-center justify-center gap-1.5 flex-wrap">
                  {dobleJugada.blancos.map((n) => (
                    <span class="inline-flex items-center justify-center w-9 h-9 bg-gray-200 text-gray-900 rounded-full text-sm font-bold">{n}</span>
                  ))}
                  <span class="inline-flex items-center justify-center w-9 h-9 bg-red-600 text-white rounded-full text-sm font-bold ml-1">{dobleJugada.powerball}</span>
                </div>
              </div>
            )}
            <div id="jackpot-status" class="text-center text-sm mb-5"></div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-center">
                <p class="text-slate-500 text-xs uppercase tracking-widest mb-1.5">Premio Estimado *</p>
                <p class="font-display text-2xl font-bold text-amber-600" id="premio-est">—</p>
              </div>
              <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-center">
                <p class="text-slate-500 text-xs uppercase tracking-widest mb-1.5">Premio En Efectivo *</p>
                <p class="font-display text-2xl font-bold text-emerald-600" id="premio-ef">—</p>
              </div>
            </div>
            <p class="text-center text-slate-500 text-xs mt-3 leading-relaxed">
              * Montos estimados del próximo sorteo; pueden estar desactualizados. Verifica el monto oficial en
              <a href="https://www.powerball.com" class="text-slate-500 hover:text-red-600 underline" target="_blank" rel="noopener noreferrer">powerball.com</a>.
            </p>
            <p class="text-center text-slate-500 text-xs mt-4 flex items-center justify-center gap-1.5">
              <i data-lucide="refresh-cw" class="w-3 h-3"></i>
              <span id="ultima-act">{ultimo ? `Sorteo del ${fechaLarga(ultimo.fecha)}` : 'Actualizado: —'}</span>
            </p>
          </div>

          <!-- ERROR STATE (solo se usa si no hubo datos de build ni respuesta del API) -->
          <div id="error-card" class="hidden bg-white border border-red-200 rounded-2xl p-10 text-center card-glow">
            <i data-lucide="alert-triangle" class="w-12 h-12 text-red-600 mx-auto mb-3"></i>
            <p class="text-slate-800 font-semibold">No se pudieron cargar los resultados</p>
            <p class="text-slate-500 text-sm mt-1">Por favor intenta de nuevo más tarde</p>
          </div>
        </div>

        <div class="flex flex-wrap justify-center gap-4 mt-8">
          <a href="#como-jugar" class="bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-6 rounded-lg transition-colors flex items-center gap-2 shadow-lg hover:shadow-red-200">
            <i data-lucide="book-open" class="w-5 h-5"></i>
            <span>Aprende a Jugar</span>
          </a>
          <a href="#premios" class="bg-blue-900 hover:bg-blue-800 text-blue-950 font-bold py-3 px-6 rounded-lg transition-colors flex items-center gap-2 shadow-lg">
            <i data-lucide="trophy" class="w-5 h-5"></i>
            <span>Ver Premios</span>
          </a>
          <a href="/resultados/" class="border border-slate-300 hover:border-red-600 text-slate-700 hover:text-blue-950 font-bold py-3 px-6 rounded-lg transition-colors flex items-center gap-2">
            <i data-lucide="history" class="w-5 h-5"></i>
            <span>Resultados Anteriores</span>
          </a>
        </div>

        <!-- ANUNCIO in-content: bajo los números ganadores -->
        <Rectangulo class="mt-10" />

        <p class="text-slate-500 text-sm max-w-2xl mx-auto mt-10 leading-relaxed">
          En esta página encontrarás los <strong class="text-slate-500">resultados de las principales loterías de Estados Unidos</strong> actualizados después de cada sorteo:
          Powerball (con Power Play y montos del jackpot), <a href="/mega-millions/" class="text-red-600 hover:underline">Mega Millions</a>,
          <a href="/lotto-america/" class="text-red-600 hover:underline">Lotto America</a> y <a href="/cash4life/" class="text-red-600 hover:underline">Cash4Life</a> — todo en español.
        </p>
      </div>
    </section>

    <!-- ======== TODOS LOS SORTEOS (datos del backend multi-juego) ======== -->
    <section id="sorteos" class="py-14 px-4">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-10">
          <h2 class="font-display text-3xl font-bold text-blue-950 mb-2">
            Todos los <span class="text-red-600">Sorteos</span> de Loterías en USA
          </h2>
          <p class="text-slate-500">Números ganadores del último sorteo de cada lotería de USA</p>
        </div>
        <div class="flex flex-wrap justify-center gap-5">
          {otrosSorteos.map(({ id, meta, data, vigente }) => {
            const especial = data ? data.sorteo[meta.bolaEspecialKey] : null;
            const mult = data && meta.multiplicadorKey ? data.sorteo[meta.multiplicadorKey] : null;
            const premio = data
              ? formatearDineroCorto(data.proximo_sorteo?.premio_estimado) ?? data.proximo_sorteo?.premio_descripcion ?? null
              : null;
            return (
              <article class="bg-white border border-slate-200 rounded-2xl p-6 flex flex-col w-full sm:w-80 shadow-sm">
                <div class="flex items-center justify-between mb-1">
                  <h3 class={`font-display text-xl font-bold ${meta.acentoClases}`}>
                    <a href={`/${meta.slug}/`} class="hover:underline">{meta.nombre}</a>
                  </h3>
                  <i data-lucide="sparkles" class={`w-5 h-5 ${meta.acentoClases}`}></i>
                </div>
                {data ? (
                  <>
                    <p class="text-slate-500 text-xs mb-4">Sorteo del {fechaConDia(data.sorteo.fecha)}</p>
                    <div class="flex items-center gap-1.5 flex-wrap mb-3">
                      {(data.sorteo.rojos ?? []).map((n) => (
                        <span class={`inline-flex items-center justify-center w-9 h-9 rounded-full text-sm font-bold ${meta.rojasClases ?? 'bg-red-600 text-white'}`}>{n}</span>
                      ))}
                      {data.sorteo.blancos.map((n) => (
                        <span class="inline-flex items-center justify-center w-9 h-9 bg-gray-200 text-gray-900 rounded-full text-sm font-bold">{n}</span>
                      ))}
                      {Number.isInteger(especial) && (
                        <span class={`inline-flex items-center justify-center w-9 h-9 rounded-full text-sm font-bold ml-1 ${meta.bolaClases}`}>{especial}</span>
                      )}
                    </div>
                    <p class={`text-xs font-semibold uppercase tracking-widest mb-4 ${meta.acentoClases}`}>
                      {meta.bolaEspecialNombre ?? 'Rojas + Blancas'}
                      {mult ? ` · ${meta.multiplicadorNombre} ${mult}x` : ''}
                    </p>
                    {!vigente && (
                      <p class="text-amber-700 text-xs bg-amber-50 border border-amber-300 rounded-lg px-3 py-2 mb-4">
                        Último resultado disponible — se actualizará automáticamente.
                      </p>
                    )}
